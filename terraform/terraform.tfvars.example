# Copy to terraform.tfvars and adjust if needed. terraform.tfvars is gitignored.
# No WinRM/credentials required — Terraform drives VBoxManage on the Windows host.

# --- VirtualBox control (defaults usually fine) ---
# vboxmanage = "/mnt/c/Program Files/Oracle/VirtualBox/VBoxManage.exe"

# --- Paths (Windows-side; C:\talos == /mnt/c/talos) ---
# iso_dir_host = "C:\\talos"
# iso_dir_wsl  = "/mnt/c/talos"
# vm_dir       = "C:\\VBox\\jeen"

# --- Isolated cluster network (defaults match host-network-setup.ps1) ---
# hostonly_adapter must match $Adapter in host-network-setup.ps1 (default below).
# hostonly_adapter  = "VirtualBox Host-Only Ethernet Adapter #2"
# gateway           = "10.66.6.1"
# nameservers       = ["1.1.1.1", "8.8.8.8"]
# control_plane_vip = "10.66.6.10"

# --- Flux / GitOps (REQUIRED) ---
github_owner = "your-github-user"
github_token = "ghp_xxx" # PAT with repo scope; keep this file gitignored
# github_repository = "jeen"
# flux_branch       = "main"
# flux_path         = "clusters/jeen"
# flux_version      = "v2.8.5"
# sops_age_key_file = "~/.config/sops/age/jeen.agekey"  # age PRIVATE key (never committed)
